# Copie para .env (nunca commite .env; o arquivo já está no .gitignore)
#
# Projeto Supabase OFICIAL do SteelSPY:
#   ref  akvbtceshpsvsuacueaq
#   URL  https://akvbtceshpsvsuacueaq.supabase.co
# As credenciais são copiadas do painel para ESTE arquivo local. Nunca coloque
# senha ou service_role em chat, issue, commit ou variável NEXT_PUBLIC_*.
#
# Connection string: Project Settings → Database → Connection string → Session pooler.
# O host direto db.<ref>.supabase.co não resolve em todas as redes; o pooler sim.
# A região está no próprio host (aws-0-<região>.pooler.supabase.com).
#
# A APLICAÇÃO conecta com a role operacional stellspy_app (NOBYPASSRLS): é isso
# que faz a RLS valer. Nunca use postgres.<ref> em DATABASE_URL.
DATABASE_URL=postgresql+psycopg2://stellspy_app.akvbtceshpsvsuacueaq:[SENHA_APP]@aws-0-[regiao].pooler.supabase.com:5432/postgres

# URL ADMINISTRATIVA, usada só para aplicar migrations (DDL e criação da role).
# Nunca a coloque no processo da aplicação.
#   python scripts/apply_migrations.py --url "$SUPABASE_DB_ADMIN_URL"
SUPABASE_DB_ADMIN_URL=postgresql+psycopg2://postgres.akvbtceshpsvsuacueaq:[SENHA_POSTGRES]@aws-0-[regiao].pooler.supabase.com:5432/postgres

# Senha da role operacional stellspy_app (a aplicação conecta com ela, sujeita a RLS).
# Mínimo 12 caracteres. O executor de migrations lê esta variável e a grava na role.
STELLSPY_APP_PASSWORD=
# Senha da role stellspy_dashboard (leitura do painel). Sem ela a role nasce
# NOLOGIN — falha fechada. Usada apenas pelo executor de migrations.
STELLSPY_DASHBOARD_PASSWORD=
# Migrações exigem o pooler em modo SESSÃO (porta 5432): o executor configura a
# senha da role por sessão antes de aplicar os arquivos. Em modo transação (6543)
# essa configuração não sobrevive entre transações.

# --- Autenticação piloto (obrigatório em produção) ---
# Cada linha em obras.api_key: header X-API-KEY (integrações) ou login PWA em /auth/pwa/login
# Desenvolvimento local / pytest: 1 para não exigir header
SKIP_API_KEY=0

# --- Sessão PWA (cookie HttpOnly; a API key não fica no JavaScript após o login) ---
# Gere um valor longo aleatório (ex.: openssl rand -hex 32)
PWA_SESSION_SECRET=
# Duração do cookie em segundos (300 a 2592000); padrão 604800 (7 dias)
# PWA_SESSION_MAX_AGE_SECONDS=604800
# Local sem HTTPS: 0. Produção: 1 (obrigatório se PWA e API em origens diferentes com SameSite=None)
PWA_COOKIE_SECURE=1
# lax | none | strict — use none se o PWA e a API estiverem em domínios diferentes (com Secure=1)
# PWA_COOKIE_SAMESITE=lax

# --- CORS (origens fixas do PWA, separadas por vírgula) ---
# Piloto local (PWA em 8080, API em 8000):
# CORS_ALLOW_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# Produção: só as origens HTTPS exatas. Curinga, null e caminho derrubam o boot.
CORS_ALLOW_ORIGINS=

# --- NF-e (NFe.io ou compatível) ---
NFE_IO_BASE_URL=https://api.nfe.io/v1
NFE_IO_TOKEN=
# 1 = não chama API real (dados mock)
NFE_IO_MOCK=0

# --- Laudo PDF (opcional) ---
LAUDO_EMISSOR_NOME=CheckObra AI
# LAUDO_LOGO_OBRA_PATH=
# LAUDO_LOGO_SISTEMA_PATH=

# --- Foto no laudo (SSRF) ---
# Opcional: lista fixa de hosts permitidos para foto_url (ex.: bucket público)
# FOTO_URL_ALLOWED_HOSTS=abcdefgh.supabase.co,outro.cdn.com

# --- Cache do laudo no Storage (opcional) ---
# URL do projeto: https://[REF].supabase.co  — Settings → API
# Usada também para validar redirect 302 do laudo (evita open redirect)
SUPABASE_URL=
# Chave publicável (Settings → API). Pode ir ao browser; o backend não a usa hoje.
SUPABASE_ANON_KEY=
# service_role (Settings → API) — só no servidor, nunca no browser
SUPABASE_SERVICE_ROLE_KEY=
LAUDO_STORAGE_BUCKET=laudos

# --- Evidências fotográficas (Storage privado) ---
# local    = disco em EVIDENCIAS_DIR (desenvolvimento/teste)
# supabase = bucket privado do projeto oficial (produção/homologação)
# A escolha é explícita: configurar SUPABASE_URL não muda o backend sozinho.
EVIDENCIAS_STORAGE=local
EVIDENCIAS_BUCKET=evidencias

# --- WhatsApp (Evolution API) — opcional; sem isso só há log no servidor ---
# WHATSAPP_DISABLED=1
# URL base do seu servidor Evolution (sem barra final)
# EVOLUTION_API_BASE_URL=https://evolution.seudominio.com
# Chave global ou da instância (header apikey)
# EVOLUTION_API_KEY=
# Nome da instância WhatsApp criada no Evolution
# EVOLUTION_INSTANCE_NAME=stellspy
# Destino global (fallback) se obras.whatsapp_destino estiver NULL — apenas dígitos
# WHATSAPP_ALERT_NUMBER=
# Retentativas Evolution (5xx, 408, 429, timeout, rede)
# EVOLUTION_MAX_TENTATIVAS=3
# EVOLUTION_BACKOFF_BASE_SEGUNDOS=1

# --- Relatório semanal CSV (job: python -m app.relatorio_semanal_main) ---
# Janela rolling em dias (UTC); padrão 7
# RELATORIO_DIAS=7
# 1 = só loga, não envia e-mail
# RELATORIO_DRY_RUN=0
# 1 = reenvia mesmo se já houver envio com a mesma chave no dia (idempotência)
# RELATORIO_FORCAR_REENVIO=0
# 1 = janela em dias corridos America/Sao_Paulo (senão: rolling puro UTC)
# RELATORIO_USAR_TZ_BR=0
# Remetente (obrigatório para enviar)
# RELATORIO_EMAIL_FROM=noreply@suaempresa.com.br
# Cópia oculta fixa (opcional), separada por vírgula — ex.: backoffice
# RELATORIO_EMAIL_COPIA=backoffice@suaempresa.com.br
#
# SMTP (SendGrid, SES, Mailgun SMTP, Office365, etc.)
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASSWORD=
# SMTP_USE_TLS=1
# Para porta 465 (SSL direto): SMTP_USE_SSL=1 e SMTP_PORT=465

# --- Dashboard Streamlit (pasta /dashboard) ---
# Credencial de menor privilégio, NÃO a DATABASE_URL da API:
#   role stellspy_dashboard (SELECT em 5 tabelas, sob RLS)
DASHBOARD_DATABASE_URL=
# UUID da construtora do piloto; sem ele o RLS devolve zero obras.
DASHBOARD_TENANT_ID=
# DASHBOARD_PASSWORD=  (obrigatória, ≥ 12; sem ela o painel não abre)
# Senha do painel é dedicada: não reutilize STELLSPY_DASHBOARD_PASSWORD nem a da API.
# Windows: set PYTHONPATH=backend && streamlit run dashboard/app.py
